    "\n",
    "    ax = axes[0]\n",
    "    for idx, (label, aucs, color, offset) in enumerate(zip(labels, auroc_data, colors, offsets)):\n",
    "        bars = ax.bar(x + offset, aucs, w, label=label, color=color, alpha=0.85)\n",
    "        ax.bar_label(bars, fmt='%.2f', padding=2, fontsize=7)\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(classes, rotation=15, ha='right')\n",
    "    ax.set_ylim(0, 1.12)\n",
    "    ax.set_ylabel('AUROC')\n",
    "    ax.set_title('Test AUROC per Class', fontweight='bold')\n",
    "    ax.axvline(len(CLASS_NAMES) - 0.5, color='grey', linestyle='--', linewidth=0.8)\n",
    "    ax.legend()\n",
    "\n",
    "    # ── Val AUROC training curves ─────────────────────────────────────────\n",
    "    ax = axes[1]\n",
    "    for h, label, color in zip(histories, labels, colors):\n",
    "        if 'val_auroc' not in h:\n",
    "            ax.text(0.5, 0.5, f'{label}\\n(no curve data)',\n",
    "                    ha='center', va='center', transform=ax.transAxes, color=color)\n",
    "            continue\n",
    "        ep = range(1, len(h['val_auroc']) + 1)\n",
    "        ax.plot(ep, h['val_auroc'], label=label, color=color)\n",
    "    ax.set_xlabel('Epoch')\n",
    "    ax.set_ylabel('Val AUROC (mean)')\n",
    "    ax.set_ylim(0, 1)\n",
    "    ax.set_title('Validation AUROC over Training', fontweight='bold')\n",
    "    ax.legend()\n",
    "\n",
    "    plt.suptitle('Model Comparison', fontsize=14, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # ── Summary table ─────────────────────────────────────────────────────\n",
    "    display(summarise_runs(histories))\n",
    "    \n",
    "def tabulate_grid_search_results(grid_search_results: List[Dict[str, Any]]) -> pd.DataFrame:\n",
    "    \"\"\"Print a summary table of grid search results.\"\"\"\n",
    "    model_name = grid_search_results[0][\"history\"][\"config\"].model_name\n",
    "    header = f'| {\"LR\":<7} | {\"Dropout\":<8} | {\"Patch Size\":<10} | {\"AUROC Mean\":<11} |'\n",
    "    separator = '-' * len(header)\n",
    "    print(f'\\n{model_name.upper()} GRID SEARCH RESULTS')\n",
    "    print(separator)\n",
    "    print(header)\n",
    "    print(separator)\n",
    "    for result in grid_search_results:\n",
    "        cfg = result[\"config\"]\n",
    "        auroc = result[\"test_auroc\"]\n",
    "        if cfg[\"dropout\"] != 1.0:\n",
    "            print(f'| {cfg[\"learning_rate\"]:<7} | {cfg[\"dropout\"]:<8.1f} | {cfg[\"patch_size\"]:<10d} | {auroc:<11.4f} |')\n",
    "    print(separator)\n",
    "    "
   ]
  },
